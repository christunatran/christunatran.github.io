#!/bin/bash

SITE_DIR="/Users/tunapee/Coding/website"
DEPLOY_DIR="/Users/tunapee/Coding/christunatran.github.io"

# Use provided commit message or default to timestamp
MSG="${1:-update $(date '+%Y-%m-%d %H:%M')}"

echo "→ copying files..."
cp -r "$SITE_DIR/." "$DEPLOY_DIR/"

echo "→ committing..."
cd "$DEPLOY_DIR"
git add .
git commit -m "$MSG"

echo "→ pushing..."
git push

echo "✓ deployed: $MSG"
